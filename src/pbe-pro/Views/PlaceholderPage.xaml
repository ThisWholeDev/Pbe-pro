<Page x:Class="PbePro.Views.PlaceholderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <Grid Margin="48,16,48,48">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <ui:Button Icon="{ui:SymbolIcon ArrowLeft24}"
                       Content="Home"
                       Click="OnHomeClick"
                       Margin="0,0,16,0" />
            <ui:TextBlock x:Name="TitleText" FontTypography="Title" VerticalAlignment="Center" />
        </StackPanel>

        <ui:TextBlock x:Name="MessageText"
                      Grid.Row="1"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />
    </Grid>
</Page>
