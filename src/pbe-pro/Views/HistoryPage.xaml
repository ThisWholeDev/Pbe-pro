<Page x:Class="PbePro.Views.HistoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="History">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>

    <Grid Margin="48,16,48,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button Content="{Binding PracticeText}" Appearance="Primary" Margin="0,0,8,0"
                           Visibility="{Binding HasMissed, Converter={StaticResource BoolToVis}}"
                           Command="{Binding PracticeMissedCommand}" />
                <ui:Button Content="Clear history"
                           Visibility="{Binding HasItems, Converter={StaticResource BoolToVis}}"
                           Command="{Binding ClearHistoryCommand}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <ui:Button Icon="{ui:SymbolIcon ArrowLeft24}" Content="Home"
                           Command="{Binding GoHomeCommand}" Margin="0,0,16,0" />
                <ui:TextBlock Text="History" FontTypography="Title" VerticalAlignment="Center" />
            </StackPanel>
        </DockPanel>

        <!-- Problems reading or saving results.json -->
        <Border Grid.Row="1" Margin="0,16,0,0" Padding="12" CornerRadius="4"
                Background="{ui:ThemeResource SystemFillColorCautionBackgroundBrush}"
                Visibility="{Binding HasNotice, Converter={StaticResource BoolToVis}}">
            <ui:TextBlock Text="{Binding NoticeText}" TextWrapping="Wrap" />
        </Border>

        <ui:TextBlock Grid.Row="2" Text="{Binding SummaryText}" Margin="2,16,0,12"
                      Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />

        <Grid Grid.Row="3">
            <ui:TextBlock Text="No quizzes completed yet. Your results are saved here when you finish a quiz."
                          HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,48,0,0"
                          Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                          Visibility="{Binding HasNoItems, Converter={StaticResource BoolToVis}}" />

            <Grid Visibility="{Binding HasItems, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340" />
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- By category, across everything saved -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <ui:TextBlock Text="By category" FontTypography="Subtitle" />
                        <ui:TextBlock Text="Across all saved quizzes, weakest first"
                                      Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Categories}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,12">
                                        <DockPanel>
                                            <ui:TextBlock DockPanel.Dock="Right" Text="{Binding PercentText, Mode=OneWay}"
                                                          FontWeight="SemiBold" />
                                            <ui:TextBlock DockPanel.Dock="Right" Text="{Binding CountText, Mode=OneWay}"
                                                          Margin="0,0,12,0"
                                                          Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />
                                            <ui:TextBlock Text="{Binding Category, Mode=OneWay}"
                                                          TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                        <ProgressBar Value="{Binding Percent, Mode=OneWay}" Maximum="100"
                                                     Height="6" Margin="0,4,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- Past quizzes -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <ui:TextBlock Grid.Row="0" Text="Past quizzes" FontTypography="Subtitle" Margin="0,0,0,12" />

                    <ListBox Grid.Row="1" ItemsSource="{Binding Items}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <DockPanel>
                                            <ui:TextBlock DockPanel.Dock="Right" Text="{Binding When}" Margin="12,0,0,0"
                                                          Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />
                                            <ui:TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                          TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                        <ui:TextBlock Text="{Binding Details}" Margin="0,4,0,0" TextWrapping="Wrap"
                                                      Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>

                                    <ui:Button Grid.Column="1" Icon="{ui:SymbolIcon Delete24}" Appearance="Transparent"
                                               ToolTip="Delete this result" VerticalAlignment="Center"
                                               Command="{Binding DataContext.DeleteResultCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                               CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
